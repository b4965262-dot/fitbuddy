# Copy to .env and fill in your Gemini API key.
GEMINI_API_KEY=

# Application settings
APP_NAME=FitBuddy
DATABASE_URL=sqlite:///./data/fitbuddy.db
ADMIN_KEY=change-me-in-production
DEBUG=true

# Current Gemini model names are configurable. See README for notes.
GEMINI_WORKOUT_MODEL=gemini-3.8-flash
GEMINI_TIP_MODEL=gemini-3.8-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_OUTPUT_TOKENS=5000
